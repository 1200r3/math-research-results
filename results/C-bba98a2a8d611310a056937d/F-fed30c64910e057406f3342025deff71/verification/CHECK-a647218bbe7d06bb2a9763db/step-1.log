info: AuditFinalQP01.lean:406:0: def PartitionLaguerre.mainClassification : Prop :=
∀ (d m : ℕ),
  2 ≤ d →
    2 ≤ m →
      (PartitionLaguerre.eventualPositiveThrough d (PartitionLaguerre.partitionCount d m) ↔
        Even d ∨ Odd d ∧ m ≤ PartitionLaguerre.criticalIndex d)
info: AuditFinalQP01.lean:407:0: def PartitionLaguerre.aboveThresholdFailure : Prop :=
