info: AuditQP01.lean:33:0: def PartitionLaguerre.mainClassification : Prop :=
∀ (d m : ℕ),
  2 ≤ d →
    2 ≤ m →
      (PartitionLaguerre.eventualPositiveThrough d (PartitionLaguerre.partitionCount d m) ↔
        Even d ∨ Odd d ∧ m ≤ PartitionLaguerre.criticalIndex d)
info: AuditQP01.lean:34:0: def PartitionLaguerre.aboveThresholdFailure : Prop :=
∀ (d m : ℕ),
  2 ≤ d →
    2 ≤ m →
      Odd d →
        PartitionLaguerre.criticalIndex d < m →
          ∃ N,
            ∀ (n : ℕ), N ≤ n → m ∣ n + 2 * d → PartitionLaguerre.laguerre d (PartitionLaguerre.partitionCount d m) n < 0
